DATABASE_URL=sqlite:///./urban_intelligence.db
GOOGLE_MAPS_API_KEY=your_google_maps_key
ML_SERVICE_URL=http://localhost:8001
PLATERECOGNIZER_TOKEN=your_token_here
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=true
UPLOAD_DIR=./backend/uploads
# Confidence threshold (0.0-1.0) for auto-accepting AI detections. >= threshold => AI_VERIFIED (auto-challan) / pothole auto-verified. Below => officer verification.
CONFIDENCE_THRESHOLD=0.80
# Max meters between a new pothole detection and an existing pothole to be merged instead of creating a duplicate.
POOTHOLE_GPS_PROXIMITY_METERS=50.0